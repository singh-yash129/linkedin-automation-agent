# LinkedIn Automation Tool - Environment Variables
# Copy this file to .env and fill in your credentials

# LinkedIn Credentials (REQUIRED)
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# Browser Settings (OPTIONAL)
BROWSER_HEADLESS=false
BROWSER_PROXY=
CHROME_PATH=

# Rate Limits (OPTIONAL - overrides config.yaml)
CONNECTION_DAILY_LIMIT=20
CONNECTION_HOURLY_LIMIT=5

# Storage Paths (OPTIONAL)
DATABASE_PATH=./data/linkedin.db
COOKIES_PATH=./data/cookies.json

# Logging (OPTIONAL)
LOG_LEVEL=info
LOG_FILE_PATH=./logs/linkedin.log
